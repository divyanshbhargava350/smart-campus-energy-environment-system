# ==============================================================================
# MITS GWALIOR SMART CAMPUS ENERGY AND ENVIRONMENT SYSTEM
# ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' and populate with your institutional credentials.
# NEVER commit the actual '.env' containing production secrets to version control.

# Server Configuration
PORT=4000
NODE_ENV=production

# JSON Web Token (JWT) Security Secret
# Generate a strong 64-character secret using: openssl rand -hex 32
JWT_SECRET=your_jwt_secret_key_change_in_production_min_32_chars

# Allowed CORS Origins (Comma-separated for multiple origins)
CORS_ORIGIN=http://localhost:5173,http://localhost:4000

# Google Maps Photorealistic 3D Tiles & CesiumJS API Key (Optional)
# Obtain from Google Cloud Console with Map Tiles API enabled
GOOGLE_MAPS_3D_KEY=YOUR_GOOGLE_MAPS_3D_TILES_API_KEY_HERE

# Database Safe Persistence Path Override (Optional - defaults to server/data)
# DATA_DIR=/custom/path/to/database/data

# Hardware / ESP32 MQTT Broker (Optional - for physical campus deployment)
MQTT_BROKER_URL=mqtt://192.168.1.50:1883
MQTT_CLIENT_ID=mits_campus_master_server
